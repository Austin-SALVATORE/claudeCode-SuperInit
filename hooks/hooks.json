{
  "modules": ["./board-link.tsx"],
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/board-answers.py\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/answer-waiter.py\"",
            "async": true,
            "asyncRewake": true,
            "timeout": 1814400
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/answer-waiter.py\"",
            "async": true,
            "asyncRewake": true,
            "timeout": 1814400
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/offer-bootstrap.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/revive-board.py\"",
            "timeout": 25
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/answer-waiter.py\"",
            "async": true,
            "asyncRewake": true,
            "timeout": 1814400
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/board-keeper.py\"",
            "if": "Write(//**/boards/*/narrative.json)",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/board-keeper.py\"",
            "if": "Edit(//**/boards/*/narrative.json)",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "p=$(cat); case \"$p\" in *narrative.json*) printf '%s' \"$p\" | python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/board-keeper.py\";; esac",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "p=$(cat); case \"$p\" in *narrative.json*) printf '%s' \"$p\" | python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/board-keeper.py\";; esac",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
